# =============================================================================
# p6cli — modo automatización por variables de entorno (ver docs, §15)
# -----------------------------------------------------------------------------
# Este archivo solo DOCUMENTA las variables. El programa no carga archivos .env:
# definelas en el sistema, en el programador de tareas o en tu orquestador.
# Uso:  p6 get project --env env --fields ObjectId,Id,Name
#
# Para uso normal NO necesitas esto: los perfiles se guardan con `p6` y las
# contraseñas en el almacén de credenciales del sistema operativo.
#
# Se llama "env.example" (sin punto inicial) a propósito: las reglas de
# permisos de Claude Code bloquean la lectura de ".env" y ".env.*".
# =============================================================================

# URL de P6 EPPM Web Services (se normaliza: puede ir completa)
P6CLI_HOST=https://localhost:7001

# Contexto web de Web Services (opcional, por defecto p6ws)
P6CLI_CONTEXT=p6ws

# Alias de la instancia de base de datos configurado en P6
P6CLI_DATABASE_NAME=orcl

P6CLI_USERNAME=admin

# Nunca la escribas en un archivo versionado
P6CLI_PASSWORD=

# true | false | ruta a un .pem de CA propia (opcional, por defecto true)
P6CLI_VERIFY_SSL=true
